# Пример конфигурации. Для локального запуска .env НЕ нужен:
# в docker-compose.yml у всех переменных есть dev-значения по умолчанию.
# Чтобы переопределить: cp .env.example .env и поменяйте нужные строки.
# Никогда не коммитьте .env с настоящими секретами.

# --- Общее ---
DEBUG=true                       # true — включает Swagger (/auth/docs, /users/docs, /beats/docs)
SECRET_KEY=change-me-to-a-long-random-string   # подпись JWT, общий для всех сервисов
ALGORITHM=HS256
HTTP_PORT=80                     # порт nginx на хосте

# --- PostgreSQL (один инстанс, отдельная база на каждый сервис) ---
DB_USER=wave
PASSWORD=change-me
POSTGRES_PORT=5432               # порт на хосте для подключения IDE/psql

# --- JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- RabbitMQ ---
RABBITMQ_LOGIN=wave
RABBITMQ_PASSWORD=change-me

# --- Email (по умолчанию письма перехватывает Mailpit: http://localhost:8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=noreply@wave.local
BASE_URL=http://localhost
# Инвайт-коды через запятую. Пусто — регистрация открыта для всех
INVITE_CODES=

# --- S3 / MinIO ---
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me-at-least-8-chars
S3_BUCKET_NAME=wave-beats

# --- YooKassa (пусто — оплата отключена; тестовые ключи: https://yookassa.ru/developers) ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost/payment/success

# --- Grafana (профиль monitoring) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
