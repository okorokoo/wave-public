S3_SECRET_KEY=minioadminpassword
S3_BUCKET_NAME=wave-beats
S3_PRESIGNED_URL_EXPIRE_SECONDS=3600
S3_DOWNLOAD_URL_EXPIRE_SECONDS=3600
